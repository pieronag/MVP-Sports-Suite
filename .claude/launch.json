{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mvp-sports-web",
        "run",
        "dev"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "app-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mvp-sports-app",
        "run",
        "web",
        "--",
        "--port",
        "8081",
        "--clear"
      ],
      "port": 8081
    }
  ]
}
