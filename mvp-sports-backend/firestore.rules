rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 👑 SEGURIDAD Y ROLES
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // La FUENTE DE VERDAD del rol es Firestore (users/profiles/staff).
    // El custom claim del token solo se usa como respaldo si no existe documento de rol.
    // Motivo: owners/api y promociones escriben el rol en Firestore; si el token tiene un
    // custom claim viejo (ej: 'owner'), este primaba sobre el rol real y bloqueaba acciones admin.
    function getRole() {
      let uid = request.auth.uid;
      let userDoc = /databases/$(database)/documents/users/$(uid);
      let profileDoc = /databases/$(database)/documents/profiles/$(uid);
      let staffDoc = /databases/$(database)/documents/staff/$(uid);

      let firestoreRole = exists(userDoc)
        ? get(userDoc).data.role
        : exists(profileDoc)
          ? get(profileDoc).data.role
          : exists(staffDoc)
            ? get(staffDoc).data.role
            : null;

      // Normalizado a minúsculas: el resto del sistema compara 'superadmin', 'owner', etc.
      return firestoreRole is string
        ? firestoreRole.lower()
        : request.auth.token.role is string
          ? request.auth.token.role.lower()
          : null;
    }

    function isSuperAdmin() {
      let role = getRole();
      return isAuthenticated() && (role == 'admin' || role == 'superadmin');
    }

    function isOwner() {
      let role = getRole();
      return isAuthenticated() && (role == 'owner' || role == 'admin' || role == 'superadmin');
    }

    function isManager() {
      let role = getRole();
      return isAuthenticated() && (role == 'manager' || role == 'owner' || role == 'admin' || role == 'superadmin');
    }

    // ==========================================
    // 🏟️ ALCANCE POR RECINTO
    // ==========================================
    // El rol (manager/owner/staff) no basta: además debe estar asignado al recinto
    // (users.tenantId / users.tenantIds) o ser su dueño (tenants.ownerId / ownerIds).
    function isMemberOfTenant(tid) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let tenantPath = /databases/$(database)/documents/tenants/$(tid);
      return tid is string && tid != '' && (
        (exists(userPath) && (
          get(userPath).data.get('tenantId', '') == tid ||
          tid in get(userPath).data.get('tenantIds', [])
        )) ||
        (exists(tenantPath) && (
          get(tenantPath).data.get('ownerId', '') == request.auth.uid ||
          request.auth.uid in get(tenantPath).data.get('ownerIds', [])
        ))
      );
    }

    // Configuración del recinto (canchas, cupones, torneos, mantenciones)
    function canManageTenant(tid) {
      return isSuperAdmin() || (isManager() && isMemberOfTenant(tid));
    }

    // Operación diaria (check-in, cobros, agenda)
    function worksAtTenant(tid) {
      return isSuperAdmin() || (isStaff() && isMemberOfTenant(tid));
    }

    // Documentos con tenantId opcional: sin recinto, solo su creador (ownerId)
    function canManageScoped(data) {
      return data.get('tenantId', '') != ''
        ? canManageTenant(data.tenantId)
        : (isSuperAdmin() || (isManager() && data.get('ownerId', '') == request.auth.uid));
    }

    // ==========================================
    // 🔒 CAMPOS PRIVILEGIADOS DE USUARIO
    // ==========================================
    // Rol, recintos asignados, permisos y estado de cuenta: el propio usuario
    // nunca puede escribirlos. Solo superadmin (cualquier valor) u owner
    // (únicamente para dar de alta/editar managers).
    function privilegedKeys() {
      // Permisos y gamificación: la experiencia, el nivel y los logros solo los calcula el servidor
      return ['role', 'tenantId', 'tenantIds', 'permissions', 'status', 'isAdmin',
              'xp', 'ovr', 'tier', 'badges', 'badgeXpBonus', 'stats', 'lastStatsUpdate', 'lastELOUpdate', 'lastBulkSync'];
    }

    function touchesPrivileged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedKeys());
    }

    // Alta propia: solo como jugador, sin recintos ni permisos
    function isSafeSelfCreate() {
      let d = request.resource.data;
      return (!('role' in d) || d.role in ['player', 'user'])
        && !('tenantId' in d && d.tenantId != '')
        && !('tenantIds' in d && d.tenantIds.size() > 0)
        && !('permissions' in d)
        && !('isAdmin' in d)
        && (!('status' in d) || d.status == 'active')
        && (!('xp' in d) || d.xp == 0)
        && (!('ovr' in d) || d.ovr <= 40);
    }

    // Owner gestionando a su personal: el rol resultante solo puede ser manager
    function isOwnerManagingManager() {
      return isOwner()
        && request.resource.data.get('role', 'manager') == 'manager'
        && (resource == null || resource.data.get('role', 'manager') in ['manager', 'player', 'user']);
    }

    function isStaff() {
      let role = getRole();
      return isAuthenticated() && (role == 'staff' || role == 'manager' || role == 'owner' || role == 'admin' || role == 'superadmin');
    }

    // ==========================================
    // 👤 PERFILES Y USUARIOS
    // ==========================================
    
    // Perfiles unificados (App y Web)
    match /profiles/{userId} {
      // Contiene correo, teléfono, RUT y fecha de nacimiento: solo el titular y el personal.
      // Los demás jugadores ven el perfil público vía /api/public-profiles.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && isSafeSelfCreate()) ||
        isOwnerManagingManager()
      );
      // El propio usuario puede eliminar su cuenta (requisito de las tiendas de apps)
      allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin() || (isOwner() && resource.data.get('role', '') == 'manager'));
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && !touchesPrivileged()) ||
        isOwnerManagingManager() ||
        (isStaff() && !touchesPrivileged())
      );

      // Subcolecciones (tarjetas, estadísticas, transacciones, etc.)
      match /{subcollection=**} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff() || isSuperAdmin());
        allow write: if isAuthenticated() && (request.auth.uid == userId || isStaff() || isSuperAdmin());
      }
    }

    match /users/{userId} {
      // Contiene correo, teléfono, RUT y fecha de nacimiento: solo el titular y el personal.
      // Los demás jugadores ven el perfil público vía /api/public-profiles.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && isSafeSelfCreate()) ||
        isOwnerManagingManager()
      );
      // El propio usuario puede eliminar su cuenta (requisito de las tiendas de apps)
      allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin() || (isOwner() && resource.data.get('role', '') == 'manager'));
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && !touchesPrivileged()) ||
        isOwnerManagingManager() ||
        (isStaff() && !touchesPrivileged())
      );
      match /{subcollection=**} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff() || isSuperAdmin());
        allow write: if isAuthenticated() && (request.auth.uid == userId || isStaff() || isSuperAdmin());
      }
    }

    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isManager() || isSuperAdmin();
    }

    // ==========================================
    // 🏛️ INFRAESTRUCTURA (RECINTOS Y CANCHAS)
    // ==========================================
    
    match /tenants/{tenantId} {
      allow read: if true;
      // Las credenciales nunca se guardan aquí (lectura pública): van a tenant_secrets
      allow create: if isSuperAdmin() && !hasTenantSecretFields();
      allow update: if !hasTenantSecretFields() && (canManageTenant(tenantId) || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'totalFeedbacks'])));
      allow delete: if isSuperAdmin();
    }

    function hasTenantSecretFields() {
      return request.resource.data.keys().hasAny(['mercadopagoAccessToken', 'siiApiKey', 'transbankApiKey']);
    }
    
    match /courts/{courtId} {
      allow read: if true;
      allow create: if canManageTenant(request.resource.data.tenantId);
      allow update: if canManageTenant(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if canManageTenant(resource.data.tenantId);
    }

    // Credenciales de pasarelas y facturación: solo Admin SDK (API routes / Functions)
    match /tenant_secrets/{tenantId} {
      allow read, write: if false;
    }

    match /settings_private/{docId} {
      allow read, write: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /gamification/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 📅 RESERVAS Y OPERATIVA
    // ==========================================
    
    // Campos de cobro de una reserva: solo personal del recinto o el servidor
    function bookingPaymentKeys() {
      return ['paymentStatus', 'paymentMethod', 'paymentRecordId', 'totalPrice', 'price', 'originalPrice', 'deposit', 'discountApplied', 'refundAmount', 'refundDetails', 'tenantId', 'courtId'];
    }

    // Proyecciones públicas de reservas (sin datos personales), escritas por la Function onBookingWritten
    match /court_slots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    match /booking_reviews/{bookingId} {
      allow read: if true;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      // Datos personales: el titular, quien la creó y el personal de recintos.
      // La disponibilidad pública se lee desde court_slots.
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('createdBy', '') == request.auth.uid ||
        resource.data.get('createdBy', '') == request.auth.token.get('email', '') ||
        request.auth.uid in resource.data.get('participantIds', []) ||
        isStaff()
      );
      // 100% online: las reservas de cancha solo las crea el servidor tras verificar el pago en
      // Mercado Pago. El jugador solo puede registrar un partido interno (sin recinto, cancha ni pago).
      allow create: if isAuthenticated() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('isInternalMatch', false) == true &&
        !request.resource.data.keys().hasAny(['tenantId', 'courtId', 'price', 'totalPrice', 'paymentStatus', 'paymentMethod', 'paymentRecordId', 'refundAmount', 'refundDetails']);
      allow update: if isAuthenticated() && (
        (worksAtTenant(resource.data.get('tenantId', '')) &&
          request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')) ||
        ((resource.data.userId == request.auth.uid || resource.data.get('userEmail', '') == request.auth.token.email) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(bookingPaymentKeys()) &&
          // Cancelar pasa por el servidor, que aplica la regla de 24 h y el reembolso
          (request.resource.data.get('status', '') != 'cancelled' || resource.data.get('status', '') == 'cancelled'))
      );
      allow delete: if canManageTenant(resource.data.get('tenantId', ''));
    }

    match /maintenance/{mId} {
      allow read: if isManager() || isSuperAdmin();
      allow create: if canManageTenant(request.resource.data.get('tenantId', ''));
      allow update, delete: if canManageTenant(resource.data.get('tenantId', ''));
    }

    // ==========================================
    // 💰 FINANZAS Y PAGOS
    // ==========================================
    
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager() || isSuperAdmin());
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /billing-subscription/{id} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create: if canManageScoped(request.resource.data);
      allow update, delete: if canManageScoped(resource.data);
    }

    // ==========================================
    // 🏆 COMPETICIÓN Y EQUIPOS
    // ==========================================
    
    // Cambio que solo agrega o quita al propio usuario en una lista
    function onlySelfToggled(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).union(before.difference(after)) == [request.auth.uid].toSet();
    }

    function onlySelfRemoved(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).size() == 0 && before.difference(after) == [request.auth.uid].toSet();
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      // Se crea a nombre propio y con el creador como único miembro inicial
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.get('members', [request.auth.uid]).toSet() == [request.auth.uid].toSet() &&
        request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isSuperAdmin() ||
        // Cualquier jugador: pedir unirse / retirar su solicitud
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinRequests']) && onlySelfToggled('joinRequests')) ||
        // Un miembro: salir del equipo
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) && onlySelfRemoved('members'))
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());

      // Chat de equipo (Solo miembros)
      match /messages/{messageId} {
        function isTeamMember() {
          return isAuthenticated() &&
            request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members;
        }
        allow read: if isTeamMember();
        // Solo a nombre propio y con texto acotado; nadie edita mensajes ajenos
        allow create: if isTeamMember() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isSuperAdmin());
      }
    }

    // ==========================================
    // ⚔️ MATCHMAKING (PARTIDOS Y JUGADORES)
    // ==========================================

    match /matchmaking/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwner() || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwner() || isSuperAdmin());
    }

    match /challenges/{challengeId} {
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isSuperAdmin());

      match /messages/{messageId} {
        function isParticipant() {
          let ch = get(/databases/$(database)/documents/challenges/$(challengeId)).data;
          return isAuthenticated() && request.auth.uid in [ch.senderId, ch.receiverId];
        }
        allow read: if isParticipant();
        allow create: if isParticipant() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isSuperAdmin());
      }
    }

    match /tournaments/{id} {
      allow read: if true;
      allow create: if canManageScoped(request.resource.data);
      allow update, delete: if canManageScoped(resource.data);
    }

    // Inscripciones: las crea el servidor (/api/tournaments/register) tras validar
    // capitán, cupos y pago. El personal del recinto puede marcar cobros en el lugar.
    match /tournament_registrations/{id} {
      allow read: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || isStaff());
      allow create: if false;
      allow update: if worksAtTenant(resource.data.get('tenantId', '')) || isSuperAdmin();
      allow delete: if canManageTenant(resource.data.get('tenantId', ''));
    }

    // Inscripciones a academias: las crea el servidor (/api/academies/enroll)
    match /academy_enrollments/{id} {
      allow read: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || isStaff());
      allow create: if false;
      allow update: if isSuperAdmin() || (isStaff() && (
        canManageScoped(resource.data) || resource.data.get('ownerId', '') == request.auth.uid));
      allow delete: if isSuperAdmin();
    }

    match /academy_classes/{id} {
      allow read: if true;
      allow create: if canManageScoped(request.resource.data);
      allow update, delete: if canManageScoped(resource.data);
    }

    // ==========================================
    // 📢 FEEDBACK Y AUDITORÍA
    // ==========================================
    
    match /reviews/{id} {
      allow read: if true;
      // Solo quien tuvo la reserva puede reseñarla
      allow create: if isAuthenticated() &&
        request.resource.data.get('userId', request.auth.uid) == request.auth.uid &&
        request.resource.data.get('bookingId', '') != '' &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.get('userId', '') == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || isSuperAdmin());
    }

    match /reports/{reportId} {
      allow read: if isManager() || isSuperAdmin();
      allow create: if isAuthenticated();
      allow update: if isManager() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin(); 
    }

    match /audit/{id} {
      allow read: if isStaff() || isSuperAdmin();
      allow write: if isStaff() || isSuperAdmin();
    }
  }
}