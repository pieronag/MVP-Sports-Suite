rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Imágenes públicas (avatares, equipos, canchas, torneos, recintos).
    // Cada usuario solo escribe en su carpeta; máx. 2 MB y solo imágenes.
    match /images/{uid}/{folder}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && folder in ['avatars', 'teams', 'courts', 'tournaments', 'venues']
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
